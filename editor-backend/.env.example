PORT=5000
NODE_ENV=development
JWT_SECRET=your-secure-jwt-secret-key
DATABASE_URL=postgres://user:password@localhost:5432/cocolabs

# Supabase Authentication Configuration
# Provide your Supabase project URL and keys to enable Supabase Auth & JWT tokens
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-public-key
# Optional: Service role key allows backend to auto-confirm accounts instantly on signup
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Optional: if Docker is installed locally or on host
RUNNER_IMAGE=ubuntu:22.04
